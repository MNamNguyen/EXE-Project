generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  mssv                String?   @unique
  email               String    @unique
  name                String
  role                Role      @default(STUDENT)
  passwordHash        String
  class               String?
  faculty             String?
  phone               String?
  isFirstLogin        Boolean   @default(true)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deviceBindings DeviceBinding[]
  otpTokens      OtpToken[]
  createdEvents  Event[]         @relation("EventCreator")
  attendances    Attendance[]
  fraudLogs      FraudLog[]
  eventMembers   EventMember[]
  createdClasses Class[]         @relation("ClassCreator")

  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@map("attendance_users")
}

enum Role {
  ADMIN
  BTC
  LECTURER
  STUDENT
}

// Trạng thái cổng điểm danh (check-in hoặc check-out) của một sự kiện.
// AUTO   — theo khung giờ đã đặt (checkinOpen/Close hoặc checkoutOpen/Close);
//          nếu chưa đặt giờ thì coi như ĐÓNG cho tới khi BTC bấm mở tay.
// OPEN   — BTC chủ động mở, bỏ qua khung giờ hoàn toàn.
// CLOSED — BTC chủ động đóng, bỏ qua khung giờ hoàn toàn.
enum GateState {
  AUTO
  OPEN
  CLOSED
}

model Event {
  id                String    @id @default(cuid())
  name              String
  description       String?
  location          String
  lat               Float?
  lng               Float?
  radius            Float     @default(100)
  gpsEnabled        Boolean   @default(true)
  // Khung giờ điểm danh giờ là TUỲ CHỌN — BTC có thể bỏ trống và chủ động
  // mở/đóng bằng checkinState/checkoutState thay vì phải đặt lịch trước.
  checkinOpen       DateTime?
  checkinClose      DateTime?
  checkoutOpen      DateTime?
  checkoutClose     DateTime?
  checkinState      GateState @default(AUTO)
  checkoutState     GateState @default(AUTO)
  bannerUrl         String?
  isWhitelisted     Boolean   @default(false)
  // Cho phép người ngoài tự đăng ký tham gia qua link công khai /dang-ky/:id.
  allowRegistration Boolean   @default(true)
  isActive          Boolean   @default(true)
  createdById       String
  // Gắn với Class khi sự kiện này là một buổi điểm danh của lớp (tạo qua
  // /api/classes/:id/sessions) — null với sự kiện thường. Xoá lớp không xoá
  // theo lịch sử buổi học nên dùng SetNull thay vì Cascade/Restrict.
  classId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy    User          @relation("EventCreator", fields: [createdById], references: [id])
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendances  Attendance[]
  fraudLogs    FraudLog[]
  eventMembers EventMember[]

  @@index([createdById])
  @@index([isActive])
  @@index([isWhitelisted])
  @@index([checkinOpen])
  @@index([isActive, checkinOpen])
  @@index([isActive, isWhitelisted])
  @@index([isActive, allowRegistration, checkinClose])
  @@index([classId])
  @@map("attendance_events")
}

// Đơn vị lớp học chính thức (tách khỏi User.class là chuỗi tự do) để BTC/Admin
// có thể tạo, đổi tên và quản lý danh sách lớp thay vì chỉnh từng sinh viên.
// User.class vẫn là chuỗi — Class.name là "nguồn sự thật" cho tên lớp; đổi tên
// một Class sẽ cập nhật lại chuỗi này trên mọi thành viên (xem class.controller).
model Class {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User    @relation("ClassCreator", fields: [createdById], references: [id])
  sessions  Event[]

  @@index([isActive])
  @@map("attendance_classes")
}

model EventMember {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("attendance_event_members")
}

model Attendance {
  id           String           @id @default(cuid())
  userId       String
  eventId      String
  checkinTime  DateTime?
  checkoutTime DateTime?
  checkinGps   Json?
  checkoutGps  Json?
  deviceId     String?
  ip           String?
  status       AttendanceStatus @default(REGISTERED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([checkinTime])
  @@index([eventId, status])
  @@index([userId, status])
  @@map("attendance_records")
}

enum AttendanceStatus {
  REGISTERED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
}

model FraudLog {
  id        String   @id @default(cuid())
  userId    String?
  eventId   String?
  reason    String
  ip        String?
  deviceId  String?
  gps       Json?
  token     String?
  metadata  Json?
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
  @@index([eventId, createdAt])
  @@map("attendance_fraud_logs")
}

model DeviceBinding {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceInfo String?
  isTrusted  Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("attendance_device_bindings")
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  deviceId  String
  purpose   String   @default("DEVICE_BIND")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, purpose])
  @@index([used, expiresAt])
  @@map("attendance_otp_tokens")
}
