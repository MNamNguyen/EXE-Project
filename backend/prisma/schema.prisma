generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  mssv                String?   @unique
  email               String    @unique
  name                String
  role                Role      @default(STUDENT)
  passwordHash        String
  class               String?
  faculty             String?
  phone               String?
  isFirstLogin        Boolean   @default(true)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deviceBindings     DeviceBinding[]
  otpTokens          OtpToken[]
  createdEvents      Event[]            @relation("EventCreator")
  attendances        Attendance[]
  fraudLogs          FraudLog[]
  eventMembers       EventMember[]
  createdClasses     Class[]            @relation("ClassCreator")
  feedbackTemplates  FeedbackTemplate[] @relation("FeedbackTemplateCreator")
  feedbackResponses  FeedbackResponse[]
  sentReminders      EventReminder[]
  certificates       Certificate[]      @relation("CertificateRecipient")
  issuedCertificates Certificate[]      @relation("CertificateIssuer")
  faceProfile        FaceProfile?

  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@map("attendance_users")
}

enum Role {
  ADMIN
  BTC
  LECTURER
  STUDENT
}

// Trạng thái cổng điểm danh (check-in hoặc check-out) của một sự kiện.
// AUTO   — theo khung giờ đã đặt (checkinOpen/Close hoặc checkoutOpen/Close);
//          nếu chưa đặt giờ thì coi như ĐÓNG cho tới khi BTC bấm mở tay.
// OPEN   — BTC chủ động mở, bỏ qua khung giờ hoàn toàn.
// CLOSED — BTC chủ động đóng, bỏ qua khung giờ hoàn toàn.
enum GateState {
  AUTO
  OPEN
  CLOSED
}

// Kiểu sự kiện — chọn lúc tạo, KHÔNG đổi được về sau.
// STANDARD   — màn chiếu QR động, người tham dự tự quét (đăng nhập + GPS + thiết bị).
// INVITATION — khách ngoài (không tài khoản) nhận thiệp mời có QR riêng, BTC/tình
//              nguyện viên quét thiệp để check-in.
//              Xem docs/superpowers/specs/2026-10-16-invitation-event-design.md
// PUBLIC     — sự kiện mở: QR cố định trên màn chiếu, người ghé thăm tự quét và điền
//              form BTC dựng. Xem docs/superpowers/specs/2026-10-16-public-checkin-design.md
enum EventKind {
  STANDARD
  INVITATION
  PUBLIC
}

model Event {
  id                String    @id @default(cuid())
  name              String
  description       String?
  location          String
  lat               Float?
  lng               Float?
  radius            Float     @default(100)
  gpsEnabled        Boolean   @default(true)
  // Khung giờ điểm danh giờ là TUỲ CHỌN — BTC có thể bỏ trống và chủ động
  // mở/đóng bằng checkinState/checkoutState thay vì phải đặt lịch trước.
  checkinOpen       DateTime?
  checkinClose      DateTime?
  checkoutOpen      DateTime?
  checkoutClose     DateTime?
  checkinState      GateState @default(AUTO)
  checkoutState     GateState @default(AUTO)
  bannerUrl         String?
  isWhitelisted     Boolean   @default(false)
  // Cho phép người ngoài tự đăng ký tham gia qua link công khai /dang-ky/:id.
  allowRegistration Boolean   @default(true)
  isActive          Boolean   @default(true)
  // Link chia sẻ báo cáo công khai: /api/public/reports/:reportShareToken xem
  // được không cần đăng nhập. NULL = chưa chia sẻ hoặc BTC đã thu hồi, nên thu
  // hồi chỉ là set NULL và link cũ chết ngay.
  reportShareToken  String?   @unique
  reportSharedAt    DateTime?
  createdById       String
  // Gắn với Class khi sự kiện này là một buổi điểm danh của lớp (tạo qua
  // /api/classes/:id/sessions) — null với sự kiện thường. Xoá lớp không xoá
  // theo lịch sử buổi học nên dùng SetNull thay vì Cascade/Restrict.
  classId           String?
  kind              EventKind @default(STANDARD)
  // Giờ bắt đầu in trên thiệp mời — bắt buộc với INVITATION, sự kiện thường không dùng.
  startsAt          DateTime?
  // Link quét thiệp cho tình nguyện viên không có tài khoản (/quet/:scannerToken).
  // Cột DB thay vì HMAC vì phải thu hồi được — giống reportShareToken.
  scannerToken      String?   @unique
  scannerSharedAt   DateTime?
  // Form check-in của sự kiện PUBLIC: { fields: [...], thankYou } — xem lib/publicForm.js.
  publicForm        Json?
  // Sơ đồ ghế của sự kiện thiệp mời: { rows: [{ label, seats }], aisleAfter, disabled }
  // — xem lib/seatMap.js. NULL = sự kiện không xếp ghế (vẫn dùng được số vé).
  seatMap           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy           User                      @relation("EventCreator", fields: [createdById], references: [id])
  class               Class?                    @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendances         Attendance[]
  fraudLogs           FraudLog[]
  eventMembers        EventMember[]
  feedbackForm        EventFeedbackForm?
  reminders           EventReminder[]
  certificateTemplate EventCertificateTemplate?
  certificates        Certificate[]
  guests              EventGuest[]
  guestKeys           EventGuestKey[]
  guestSeats          EventGuestSeat[]
  invitationTemplate  EventInvitationTemplate?

  @@index([createdById])
  @@index([isActive])
  @@index([isWhitelisted])
  @@index([checkinOpen])
  @@index([isActive, checkinOpen])
  @@index([isActive, isWhitelisted])
  @@index([isActive, allowRegistration, checkinClose])
  @@index([classId])
  @@map("attendance_events")
}

// Đơn vị lớp học chính thức (tách khỏi User.class là chuỗi tự do) để BTC/Admin
// có thể tạo, đổi tên và quản lý danh sách lớp thay vì chỉnh từng sinh viên.
// User.class vẫn là chuỗi — Class.name là "nguồn sự thật" cho tên lớp; đổi tên
// một Class sẽ cập nhật lại chuỗi này trên mọi thành viên (xem class.controller).
model Class {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User    @relation("ClassCreator", fields: [createdById], references: [id])
  sessions  Event[]

  @@index([isActive])
  @@map("attendance_classes")
}

model EventMember {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("attendance_event_members")
}

model Attendance {
  id           String           @id @default(cuid())
  userId       String
  eventId      String
  checkinTime  DateTime?
  checkoutTime DateTime?
  checkinGps   Json?
  checkoutGps  Json?
  deviceId     String?
  ip           String?
  status       AttendanceStatus @default(REGISTERED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([checkinTime])
  @@index([eventId, status])
  @@index([userId, status])
  @@map("attendance_records")
}

enum AttendanceStatus {
  REGISTERED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
}

model FraudLog {
  id        String   @id @default(cuid())
  userId    String?
  eventId   String?
  reason    String
  ip        String?
  deviceId  String?
  gps       Json?
  token     String?
  metadata  Json?
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
  @@index([eventId, createdAt])
  @@map("attendance_fraud_logs")
}

model DeviceBinding {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  deviceInfo String?
  isTrusted  Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("attendance_device_bindings")
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  deviceId  String
  purpose   String   @default("DEVICE_BIND")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, purpose])
  @@index([used, expiresAt])
  @@map("attendance_otp_tokens")
}

// ───────────────────────────────────────────────────────────────
// Đánh giá sau sự kiện
// ───────────────────────────────────────────────────────────────
//
// questions (JSON) có cùng hình dạng ở mẫu và form:
//   [{ id, type: 'TEXT' | 'RATING', label, required }]
// Kiểm tra/chuẩn hoá ở lib/feedbackForm.js — DB không ràng buộc cấu trúc JSON.

// Thư viện mẫu dùng chung cho ADMIN + BTC. Người tạo bị xoá thì mẫu vẫn giữ
// (SetNull) vì người khác có thể đang dùng.
model FeedbackTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  questions   Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?               @relation("FeedbackTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  forms     EventFeedbackForm[]

  @@index([createdById])
  @@map("attendance_feedback_templates")
}

// Form đánh giá của MỘT sự kiện. questions là BẢN SAO lấy từ mẫu lúc gắn —
// sửa mẫu về sau không được làm đổi câu hỏi dưới những câu trả lời đã có.
// templateId chỉ để hiển thị "tạo từ mẫu nào", xoá mẫu thì form vẫn nguyên.
model EventFeedbackForm {
  id          String   @id @default(cuid())
  eventId     String   @unique
  templateId  String?
  title       String
  description String?
  questions   Json
  // Ẩn danh: server vẫn lưu userId (mỗi người một phiếu) nhưng không API nào
  // trả ra ai đã viết gì. Đã có phiếu thì chỉ được bật, không được tắt.
  isAnonymous Boolean  @default(false)
  // BTC mở/đóng tay — không có khung giờ.
  isOpen      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template  FeedbackTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  responses FeedbackResponse[]

  @@index([templateId])
  @@map("attendance_feedback_forms")
}

// Phiếu trả lời: answers = { [questionId]: string | 1..5 }. Xoá tài khoản thì
// phiếu vẫn giữ (SetNull) để số liệu tổng hợp của sự kiện không bị đổi.
model FeedbackResponse {
  id        String   @id @default(cuid())
  formId    String
  userId    String?
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form EventFeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([formId, userId])
  @@index([formId])
  @@index([userId])
  @@map("attendance_feedback_responses")
}

// Nhật ký mỗi lượt BTC bấm "Gửi nhắc ngay": hiện lịch sử trong trang sự kiện và
// là mốc tính thời gian chờ giữa hai lần gửi (MANUAL_COOLDOWN_MS).
model EventReminder {
  id             String    @id @default(cuid())
  eventId        String
  status         String    @default("SENDING") // SENDING | SENT | FAILED
  recipientCount Int       @default(0)
  failedCount    Int       @default(0)
  note           String?
  triggeredById  String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggeredBy User? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([triggeredById])
  @@map("attendance_event_reminders")
}

// ───────────────────────────────────────────────────────────────
// Chứng nhận tham gia — TUỲ CHỌN theo sự kiện: không upload mẫu = không có chứng nhận
// ───────────────────────────────────────────────────────────────

// Mẫu chứng nhận của MỘT sự kiện: ảnh nền PNG/JPG (lưu thẳng trong DB vì Render
// xoá ổ đĩa mỗi lần deploy và dự án không có kho file) + vị trí các ô thông tin.
// fields (JSON) = [{ key: name|event|date|code, enabled, x, y, size, maxWidth,
// font, color, align }] — toạ độ/cỡ chữ là TỈ LỆ theo ảnh, xem lib/certificateLayout.js.
model EventCertificateTemplate {
  id          String   @id @default(cuid())
  eventId     String   @unique
  image       Bytes
  mimeType    String
  width       Int
  height      Int
  fields      Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("attendance_certificate_templates")
}

// Chứng nhận đã cấp. PDF KHÔNG lưu sẵn — vẽ lại từ mẫu mỗi lần tải. recipientName
// chụp lại lúc cấp để chứng nhận không tự đổi khi tài khoản đổi tên.
model Certificate {
  id            String    @id @default(cuid())
  code          String    @unique
  eventId       String
  userId        String
  recipientName String
  issuedAt      DateTime  @default(now())
  issuedById    String?
  emailStatus   String    @default("PENDING") // PENDING | SENDING | SENT | FAILED
  emailSentAt   DateTime?

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User  @relation("CertificateRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([issuedById])
  @@map("attendance_certificates")
}

// ───────────────────────────────────────────────────────────────
// Sự kiện thiệp mời — khách ngoài, không có tài khoản
// ───────────────────────────────────────────────────────────────

// Một khách trong danh sách mời. Không gắn với User: khách không có tài khoản, nên
// đánh giá/chứng nhận/nhắc lịch (đều theo tài khoản) không áp dụng cho kiểu này.
// code là bí mật in trong QR của thiệp — cấp lại mã là thiệp cũ hết dùng được.
model EventGuest {
  id           String    @id @default(cuid())
  eventId      String
  name         String
  phone        String?
  email        String?
  code         String    @unique
  // Khách tới cửa mà không có trong danh sách, BTC/tình nguyện viên thêm tại chỗ.
  isWalkIn     Boolean   @default(false)
  inviteStatus String    @default("PENDING") // PENDING | SENDING | SENT | FAILED
  inviteSentAt DateTime?
  checkedInAt  DateTime?
  // Tên hiển thị người quét ("Nguyễn A" hoặc "Link quét") — chỉ để tra lại, không phải khoá ngoại.
  checkedInBy  String?
  // Sự kiện PUBLIC: câu trả lời form check-in { fieldId: string | string[] }.
  answers      Json?
  // Một người đặt hộ nhiều vé cho người thân nhưng chỉ có MỘT thiệp/mã QR — quét một
  // lần là cả nhóm vào. Không lưu tên từng người đi kèm, chỉ số lượng.
  ticketCount  Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  keys  EventGuestKey[]
  seats EventGuestSeat[]

  // Email trùng trong cùng sự kiện là nhập trùng; Postgres cho nhiều NULL nên khách
  // không có email không vướng ràng buộc này.
  @@unique([eventId, email])
  @@index([eventId])
  @@index([eventId, checkedInAt])
  @@map("attendance_event_guests")
}

// Khoá chống trùng của check-in công khai: key = "fieldId:giá trị đã chuẩn hoá" của
// các trường BTC tick "chống trùng". Unique theo sự kiện nên hai người gửi cùng SĐT cùng
// lúc thì một bên bị chặn ngay ở DB (P2002), không cần khoá ứng dụng.
model EventGuestKey {
  id      String @id @default(cuid())
  eventId String
  guestId String
  key     String

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest EventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@index([guestId])
  @@map("attendance_event_guest_keys")
}

// Ghế đã gán cho khách mời (seat = "E08", xem lib/seatMap.js). Unique theo sự kiện
// nên hai BTC gán cùng một ghế cùng lúc thì một bên bị chặn ngay ở DB (P2002).
model EventGuestSeat {
  id      String @id @default(cuid())
  eventId String
  guestId String
  seat    String

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest EventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, seat])
  @@index([guestId])
  @@map("attendance_event_guest_seats")
}

// Mẫu thiệp mời của MỘT sự kiện — cùng cách lưu với EventCertificateTemplate (ảnh
// trong DB vì ổ đĩa Render bị xoá mỗi lần deploy). Không có mẫu thì dùng thiệp mặc
// định. fields: xem lib/invitationLayout.js.
model EventInvitationTemplate {
  id          String   @id @default(cuid())
  eventId     String   @unique
  image       Bytes
  mimeType    String
  width       Int
  height      Int
  fields      Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("attendance_invitation_templates")
}

// TÍNH NĂNG ĐANG GỠ (2026-10-22, trang bị lag sau khi deploy): code đã bỏ, model GIỮ LẠI vì
// bảng trên Supabase có dữ liệu — xoá model thì `prisma db push` lúc build Render đòi drop
// bảng và build hỏng. Bật lại: xem commit 9fa3fc4 và spec 2026-10-22-face-checkin-design.md.
//
// Khuôn mặt dùng cho check-in tại cửa (kiosk BTC). Embedding do TRÌNH DUYỆT tính
// (@vladmandic/human, faceres 1024 chiều) — server không chạy mô hình, chỉ lưu và so
// vector, xem lib/faceProfile.js. Không lưu ảnh gốc: chỉ vector + thumbnail nhỏ để
// người đứng cửa nhìn đối chiếu. Dữ liệu sinh trắc học là dữ liệu nhạy cảm nên kiosk
// chỉ dùng profile đã có consentAt; ảnh admin import mặc định chưa đồng ý.
model FaceProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  embedding       Bytes
  // Khác FACE_MODEL hiện tại = vector của mô hình cũ, không so được → coi như chưa có.
  model           String
  thumbnail       Bytes?
  source          String // SELF | IMPORT
  // Vector ảnh admin import, giữ lại để ảnh sinh viên tự chụp phải giống ảnh này.
  importEmbedding Bytes?
  consentAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendance_face_profiles")
}
